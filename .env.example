# Copy this file to .env. The application loads it automatically.
# Offline mode does not require credentials and is always the default.
# Credentials alone never enable network access; live mode must be explicit.
MODEL_MODE=mock

# Required only when MODEL_MODE=live. Never commit or package the real .env.
OPENAI_API_KEY=
OPENAI_MODEL=your-model-name
OPENAI_BASE_URL=

# Alternative OpenAI-compatible DeepSeek configuration:
# MODEL_MODE=live
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# Explicit execution budgets.
MAX_MODEL_STEPS=10
MAX_TOOL_CALLS=8
MAX_INVALID_DECISIONS=2
MODEL_TIMEOUT_SECONDS=60

